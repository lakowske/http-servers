FROM docker.io/library/debian:bookworm-slim

# Install system packages first (most cacheable layer)
RUN apt-get update && \
    apt-get install -y \
        procps \
        net-tools \
        supervisor \
        rsyslog \
        python3 \
        python3-pip \
        python3-venv \
        telnet \
        inotify-tools \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install mail-specific packages (separate layer for better caching)
RUN apt-get update && \
    apt-get install -y \
        postfix \
        dovecot-core \
        dovecot-imapd \
        mailutils \
        mutt \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a virtual environment for the mail server management script
RUN python3 -m venv /usr/local/venv \
    && /usr/local/venv/bin/pip install --upgrade pip \
    && /usr/local/venv/bin/pip install --no-cache-dir requests flask inotify

# Create app directory for the mail server management script
RUN mkdir -p /usr/local/actions

# Create virtual mail directory, user and group. This user will own the mail directories.
RUN useradd -r -u 5000 -g mail -d /var/vmail -s /sbin/nologin -c "Virtual Mail User" vmail \
    && mkdir -p /var/vmail \
    && chown vmail:mail /var/vmail \
    && chmod 770 /var/vmail

# Create the SSL/TLS certificate directory
RUN mkdir -p /etc/ssl/certs/server
RUN mkdir -p /etc/ssl/certs/letsencrypt

# Create supervisor configuration directory
RUN mkdir -p /etc/supervisor/conf.d

# Copy configuration files
COPY build/mail/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY build/mail/main.cf /etc/postfix/main.cf
COPY build/mail/master.cf /etc/postfix/master.cf
COPY build/mail/dovecot.conf /etc/dovecot/dovecot.conf
COPY build/mail/virtual_mailbox_maps /etc/postfix/virtual_mailbox_maps
COPY build/mail/passwd /etc/ssl/certs/server/passwd
COPY build/mail/now_mail.py /usr/local/actions/now_mail.py

# Make management script executable
RUN chmod +x /usr/local/actions/now_mail.py


# Expose SMTP port
EXPOSE 25 587
# Expose submission port
EXPOSE 465
# Expose IMAP port
EXPOSE 993
# Expose POP3 port
EXPOSE 995

# Configuration and users will be managed at runtime via mounted volumes and init scripts
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
